# PostgreSQL
POSTGRES_USER=mbaca
POSTGRES_PASSWORD=mbaca_secret
POSTGRES_DB=mbaca_buku

# Redis
REDIS_URL=redis://redis:6379/0

# Cloudflare R2
# Host only — no https:// prefix and no bucket name suffix.
R2_ENDPOINT=<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=<access-key-id>
R2_SECRET_ACCESS_KEY=<secret-access-key>
R2_BUCKET=mbaca-buku

# Backend
JWT_SECRET=mbaca-buku-jwt-secret-change-in-production
SERVER_PORT=8080
DB_HOST=postgres
DB_PORT=5432
DB_USER=mbaca
DB_PASSWORD=mbaca_secret
DB_NAME=mbaca_buku
DB_SSLMODE=disable

# Frontend
VITE_API_URL=/api
