# Supabase PostgreSQL
# Dashboard -> Connect -> Session pooler. Use the pooler host on port 5432:
# the direct connection is IPv6-only, and the transaction pooler (6543) does
# not support the prepared statements lib/pq relies on.
#
# Compose interpolates $VAR inside .env values, so a "$" in the password is
# silently eaten and the URL reaches the backend mangled. Either percent-encode
# it as %24, escape it as $$, or use a password without "$".
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Redis
REDIS_URL=redis://redis:6379/0

# Cloudflare R2
# Host only — no https:// prefix and no bucket name suffix.
R2_ENDPOINT=<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=<access-key-id>
R2_SECRET_ACCESS_KEY=<secret-access-key>
R2_BUCKET=mbaca-buku

# Backend
JWT_SECRET=mbaca-buku-jwt-secret-change-in-production
SERVER_PORT=8080

# Frontend
VITE_API_URL=/api
