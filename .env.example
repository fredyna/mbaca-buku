# Supabase PostgreSQL
# Dashboard -> Connect -> Session pooler. Use the pooler host on port 5432:
# the direct connection is IPv6-only, and the transaction pooler (6543) does
# not support the prepared statements lib/pq relies on.
#
# Compose interpolates $VAR inside .env values, so a "$" in the password is
# silently eaten and the URL reaches the backend mangled. Either percent-encode
# it as %24, escape it as $$, or use a password without "$".
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Redis
REDIS_URL=redis://redis:6379/0

# Cloudflare R2
# Host only — no https:// prefix and no bucket name suffix.
R2_ENDPOINT=<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=<access-key-id>
R2_SECRET_ACCESS_KEY=<secret-access-key>
R2_BUCKET=mbaca-buku

# Backend
JWT_SECRET=mbaca-buku-jwt-secret-change-in-production
SERVER_PORT=8080

# Browser origins the API answers, comma-separated. Browsers send an Origin
# header on every POST, so an origin missing here gets a bare 403 that the
# login page reports as "Invalid email or password". Name the exact origin the
# site is served from, scheme and port included.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:6900

# Sign in with Google, via Supabase Auth.
#
# The browser completes the OAuth flow with Supabase, then hands the API the
# resulting access token; the API asks Supabase who it belongs to and issues its
# own JWT for the matching row in the users table. Both sides therefore need the
# same project — Compose passes these two through to the frontend build as
# VITE_SUPABASE_URL and VITE_SUPABASE_ANON_KEY, so they are set only once here.
#
# Dashboard -> Project Settings -> API for both values. Leave both blank to ship
# password login only: the API starts fine, the Google button is hidden, and
# /auth/oauth reports that it is unconfigured.
#
# Two more settings live in the Supabase dashboard itself, not here:
# Authentication -> Providers -> Google must be enabled with a Google OAuth
# client, and every origin the app is served from must be listed under
# Authentication -> URL Configuration -> Redirect URLs, or Google will bounce
# users back to the Site URL instead of this app.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<anon-public-key>

# Frontend
VITE_API_URL=/api
